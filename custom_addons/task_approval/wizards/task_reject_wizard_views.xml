<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_reject_wizard_form" model="ir.ui.view">
        <field name="name">task.reject.wizard.form</field>
        <field name="model">task.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Task">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="reason"
                           placeholder="Explain why this task is being rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Reject"
                            type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
