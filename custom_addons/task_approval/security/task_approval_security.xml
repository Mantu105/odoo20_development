<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- Application category (groups the two roles in Settings)      -->
        <!-- ============================================================ -->
        <record id="module_category_task_approval" model="ir.module.category">
            <field name="name">Task Approval</field>
            <field name="description">Task approval workflow roles.</field>
            <field name="sequence">10</field>
        </record>

        <!-- res.groups no longer links to ir.module.category directly (19.0);
             groups now go through a res.groups.privilege. -->
        <record id="privilege_task_approval" model="res.groups.privilege">
            <field name="name">Task Approval</field>
            <field name="category_id" ref="module_category_task_approval"/>
            <field name="sequence">10</field>
        </record>

        <!-- ============================================================ -->
        <!-- Security groups                                              -->
        <!-- ============================================================ -->
        <record id="group_task_approval_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="privilege_task_approval"/>
            <field name="comment">
                Can create, edit and submit their own tasks.
            </field>
        </record>

        <record id="group_task_approval_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_task_approval"/>
            <!-- Manager inherits every Employee right. -->
            <field name="implied_ids"
                   eval="[(4, ref('group_task_approval_employee'))]"/>
            <field name="comment">
                Can see all tasks and approve or reject submitted tasks.
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Record rules                                                 -->
        <!-- ============================================================ -->
        <!-- Odoo 20 merges ir.model.access and ir.rule into a single
             ir.access model (group_id + operation + domain). Employees are
             restricted to their own tasks and managers to all tasks via the
             domain column of security/ir.access.csv, not here. -->

    </data>
</odoo>
